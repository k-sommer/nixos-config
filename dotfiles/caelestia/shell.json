{
    "appearance": {
        "transparency": {
            "enabled": false
        }
    },
    "background": {
        "desktopClock": {
            "background": {
                "blur": true
            },
            "enabled": false,
            "invertColors": true,
            "position": "top-right",
            "shadow": {
                "enabled": true
            }
        },
        "wallpaperEnabled": true
    },
    "bar": {
        "activeWindow": {
            "compact": true,
            "inverted": true
        },
        "clock": {
            "background": false,
            "showDate": true,
            "showIcon": false
        },
        "persistent": true,
        "status": {
            "showLockStatus": false,
            "showWifi": false
        },
        "tray": {
            "background": false,
            "recolour": true
        },
        "workspaces": {
            "activeTrail": false,
            "occupiedBg": false,
            "showWindows": true,
            "shown": 4
        }
    },
    "border": {
        "rounding": 15
    },
    "dashboard": {
        "enabled": true,
        "performance": {
            "showMemory": true,
            "showNetwork": true,
            "showStorage": true
        }
    },
    "general": {
        "apps": {
            "explorer": [
                "nautilus",
                "--new-window"
            ],
            "terminal": [
                "kitty"
            ]
        },
        "idle": {
            "inhibitWhenAudio": true,
            "lockBeforeSleep": true,
            "timeouts": [
                {
                    "idleAction": "lock",
                    "timeout": 7200
                },
                {
                    "idleAction": "dpms off",
                    "returnAction": "dpms on",
                    "timeout": 14400
                },
                {
                    "idleAction": [
                        "systemctl",
                        "suspend-then-hibernate"
                    ],
                    "timeout": 21600
                }
            ]
        }
    },
    "launcher": {
        "hiddenApps": [
            "xterm",
            "qt6ct",
            "qt5ct",
            "openra-ra",
            "openra-cnc",
            "nixos-manual",
            "micro",
            "kvantummanager",
            "org.flameshot.Flameshot",
            "org.gnome.eog",
            "org.gnome.Evince",
            "nvidia-settings",
            "No Man's Sky",
            "PEAK",
            "org.gnome.Totem",
            "R.E.P.O.",
            "Don't Starve Together",
            "Anno 1800",
            "org.openrgb.OpenRGB",
            "Anno 2205"
        ],
        "maxShown": 6,
        "showOnHover": true
    },
    "paths": {
        "sessionGif": "/home/sommer/nixos-config/assets/nixos.png"
    },
    "services": {
        "gpuType": ""
    }
}
